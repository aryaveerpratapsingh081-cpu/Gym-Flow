# GymFlow Environment Configuration Template
# Copy this file to .env in the server directory and configure your credentials

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------
# Option 1: MongoDB Atlas (Cloud)
# Replace <username>, <password>, and <cluster-url> with your Atlas details:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gymflow?retryWrites=true&w=majority

# Option 2: Local MongoDB Daemon (Community Edition)
MONGO_URI=mongodb://127.0.0.1:27017/gymflow

# -------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -------------------------------------------------------------
JWT_SECRET=gymflow_dbms_lab_review_super_secret_jwt_key_2026
